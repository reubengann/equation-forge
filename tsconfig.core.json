{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "src/types/algebrite.d.ts",
    "src/math/index.ts",
    "src/math/ast/index.ts",
    "src/math/adapters/latex/index.ts",
    "src/math/adapters/sympy/index.ts",
    "src/math/compile/index.ts",
    "src/math/adapters/algebrite/index.ts"
  ]
}
