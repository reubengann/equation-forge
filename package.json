{
  "name": "@equation-forge/core",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/ui"
  ],
  "main": "./dist/math/index.js",
  "types": "./dist/math/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./ast": {
      "types": "./dist/math/ast/index.d.ts",
      "import": "./dist/math/ast/index.js"
    },
    "./latex": {
      "types": "./dist/math/adapters/latex/index.d.ts",
      "import": "./dist/math/adapters/latex/index.js"
    },
    "./sympy": {
      "types": "./dist/math/adapters/sympy/index.d.ts",
      "import": "./dist/math/adapters/sympy/index.js"
    },
    "./compile": {
      "types": "./dist/math/compile/index.d.ts",
      "import": "./dist/math/compile/index.js"
    },
    "./selection": {
      "types": "./dist/math/selection/index.d.ts",
      "import": "./dist/math/selection/index.js"
    },
    "./rewrite": {
      "types": "./dist/math/rewrite/index.d.ts",
      "import": "./dist/math/rewrite/index.js"
    },
    "./algebrite": {
      "types": "./dist/math/adapters/algebrite/index.d.ts",
      "import": "./dist/math/adapters/algebrite/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/math/index.*",
    "dist/math/ast",
    "dist/math/adapters/latex",
    "dist/math/adapters/sympy",
    "dist/math/adapters/algebrite",
    "dist/math/compile",
    "dist/math/selection",
    "dist/math/rewrite"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:core && tsc -b && vite build && npm run build:core && npm run build:ui",
    "build:try": "npm run build:core && tsc -b && vite build --mode public --base /equation-forge/try/ && node scripts/copyMathliveFonts.mjs",
    "build:core": "tsc -p tsconfig.core.json",
    "prebuild:ui": "node scripts/generateMacroIconModule.mjs && node scripts/generateUiIconModule.mjs",
    "build:ui": "tsc -p tsconfig.ui.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "mathtests": "tsx ./scripts/mathtests.ts",
    "gen_mathtests": "tsx ./scripts/gen_mathtests.ts",
    "fuzz:rewrites": "tsx ./scripts/fuzzRewrites.ts",
    "check": "npm run test:run && npm run mathtests && npm run build",
    "pretest": "npm run build:core && npm run build:ui",
    "test": "vitest",
    "pretest:run": "npm run build:core && npm run build:ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
    "algebrite": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "^0.45.9",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "mathlive": "^0.110.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
