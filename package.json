{
  "name": "@physics-derivation-pad/core",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/math/index.js",
  "types": "./dist/math/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./ast": {
      "types": "./dist/math/ast/index.d.ts",
      "import": "./dist/math/ast/index.js"
    },
    "./latex": {
      "types": "./dist/math/adapters/latex/index.d.ts",
      "import": "./dist/math/adapters/latex/index.js"
    },
    "./sympy": {
      "types": "./dist/math/adapters/sympy/index.d.ts",
      "import": "./dist/math/adapters/sympy/index.js"
    },
    "./compile": {
      "types": "./dist/math/compile/index.d.ts",
      "import": "./dist/math/compile/index.js"
    },
    "./algebrite": {
      "types": "./dist/math/adapters/algebrite/index.d.ts",
      "import": "./dist/math/adapters/algebrite/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/math/index.*",
    "dist/math/ast",
    "dist/math/adapters/latex",
    "dist/math/adapters/sympy",
    "dist/math/adapters/algebrite",
    "dist/math/compile"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:core",
    "build:core": "tsc -p tsconfig.core.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "mathtests": "tsx ./scripts/mathtests.ts",
    "gen_mathtests": "tsx ./scripts/gen_mathtests.ts",
    "fuzz:rewrites": "tsx ./scripts/fuzzRewrites.ts",
    "check": "npm run test:run && npm run mathtests && npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
    "algebrite": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.8.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "mathlive": "^0.109.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
